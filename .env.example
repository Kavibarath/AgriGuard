# Copy to .env for local development. .env is git-ignored — never commit real values.
# Local-only credentials for the docker-compose PostgreSQL container.
POSTGRES_DB=agriguard
POSTGRES_USER=agriguard
POSTGRES_PASSWORD=change_me_local_only
# Host port for the container (5433 avoids clashing with a native PostgreSQL on 5432).
POSTGRES_PORT=5433

# The API reads its connection string from user-secrets locally:
#   dotnet user-secrets set "ConnectionStrings:Default" "Host=localhost;Port=5433;Database=agriguard;Username=agriguard;Password=<POSTGRES_PASSWORD>" --project backend/src/AgriGuard.Api
# In the cloud it is supplied as the environment variable ConnectionStrings__Default.
#
# The JWT signing key (>= 32 random bytes, base64) is also a user-secret locally and Jwt__SigningKey in the cloud:
#   dotnet user-secrets set "Jwt:SigningKey" "<openssl rand -base64 32>" --project backend/src/AgriGuard.Api
