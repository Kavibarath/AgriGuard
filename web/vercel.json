{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/openmeteo/v1/forecast", "destination": "https://api.open-meteo.com/v1/forecast" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
