# Copy to .env.local for overrides. Vite only exposes variables prefixed VITE_ to the browser.
# Base URL of the ASP.NET Core API (no trailing slash). Defaults to the local dev API when unset.
VITE_API_BASE_URL=http://localhost:5000

# Show the one-click demo accounts on the sign-in page. Always on in `npm run dev`; set to true
# for a demo deployment (the viva), and leave unset for anything real.
# VITE_DEMO_ACCOUNTS=true
