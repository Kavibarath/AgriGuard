<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app has no dark theme yet, so dark mode launches on the same warm page rather than
         flashing black before a light screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/agriguard_page</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/agriguard_page</item>
    </style>
</resources>
